rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidInjection(data) {
      return data.keys().hasAll(['date', 'zone', 'lotNumber', 'expirationDate']) &&
             data.zone is int &&
             data.zone >= 1 && data.zone <= 4 &&
             data.lotNumber is string &&
             data.lotNumber.size() > 0 &&
             data.lotNumber.size() <= 100;
    }

    function isValidPreferences(data) {
      return data.keys().hasAll(['intervalDays', 'reminderTime', 'notificationsEnabled']) &&
             data.intervalDays is int &&
             data.intervalDays >= 1 && data.intervalDays <= 90 &&
             data.reminderTime is string &&
             data.reminderTime.size() <= 10 &&
             data.notificationsEnabled is bool &&
             (!('timeZone' in data) || (data.timeZone is string && data.timeZone.size() <= 100)) &&
             (!('lastReminderSentForDate' in data) || (data.lastReminderSentForDate is string && data.lastReminderSentForDate.size() <= 50));
    }

    function isValidFcmToken(data) {
      return data.keys().hasAll(['token', 'enabled']) &&
             data.token is string &&
             data.token.size() >= 10 &&
             data.token.size() <= 500 &&
             data.enabled is bool &&
             (!('timeZone' in data) || (data.timeZone is string && data.timeZone.size() <= 100)) &&
             (!('userAgent' in data) || (data.userAgent is string && data.userAgent.size() <= 255)) &&
             (!('platform' in data) || (data.platform is string && data.platform.size() <= 100));
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /injections/{injectionId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidInjection(request.resource.data);
        allow update: if isOwner(userId) && isValidInjection(request.resource.data);
      }

      match /settings/{settingId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidPreferences(request.resource.data);
      }

      match /fcmTokens/{tokenId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidFcmToken(request.resource.data);
        allow update: if isOwner(userId) && isValidFcmToken(request.resource.data);
      }
    }
  }
}
